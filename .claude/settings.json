{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-log.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__merge_pull_request|mcp__github__enable_pr_auto_merge",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-check.sh", "timeout": 30 }]
      }
    ]
  }
}
